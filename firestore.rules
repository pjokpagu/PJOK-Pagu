rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() <= 64;
    }

    match /kkg_data/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }
  }
}
